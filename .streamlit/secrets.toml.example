# MongoDB Atlas Credentials (Required for Streamlit Community Cloud Global Deployment)
# Replace the placeholder values with your MongoDB Atlas connection string:
MONGO_URI = "mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/?appName=Cluster0"
DB_NAME = "StockDB"
COLLECTION_NAME = "news_sentiment"
LOGS_COLLECTION_NAME = "pipeline_logs"
