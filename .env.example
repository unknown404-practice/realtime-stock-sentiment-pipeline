# ==============================================================================
# Stock News Sentiment Pipeline Environment Configuration
# ==============================================================================

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=stock-news
KAFKA_GROUP_ID=finbert-sentiment-consumer-group
KAFKA_NUM_PARTITIONS=4
PUBLISH_INTERVAL_SECONDS=0.8

# MongoDB Local Authentication
MONGO_USER=admin
MONGO_PASSWORD=securepassword123
LOCAL_MONGO_URI=mongodb://admin:securepassword123@localhost:27017/StockDB?authSource=admin
DB_NAME=StockDB
COLLECTION_NAME=news_sentiment
LOGS_COLLECTION_NAME=pipeline_logs

# MongoDB Atlas (Optional Global Cloud Cluster)
MONGO_URI=

# Financial News Ingestion API (Optional: Free tier from finnhub.io)
FINNHUB_API_KEY=

# ML / FinBERT Configuration
MODEL_NAME=ProsusAI/finbert
BATCH_SIZE=16
